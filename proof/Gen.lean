import Equid

/-!
`lake exe gen [out.rs]` prints the proven feature formulas (`Equid.features`) as Rust and writes
`../engine/src/metrics_gen.rs` (run it from `proof/`).

The `inputs` function below is hand-written Rust kept as a string: it only *reads* the edge
(field reads, Option defaults, two small lookup tables, the shade slot for the time of day).
It is not proven, and it does not need to be for non-negativity: the theorem holds for *any*
values of the signed readings, counts and flags. It relies only on `len`, `climb`, `speed` and `junction`
being >= 0: `Graph::validate` checks the first two, speed is a positive constant, and `junction` is
>= 0 by `junction_charge_nonneg`.
-/

open Equid

def header : String := "// GENERATED by `cd proof && lake exe gen` from proof/Equid/Features.lean. Do not edit by hand.
//
// The 20 formulas in `features_of` are printed from the Lean terms that are machine-checked to be
// >= 0 (theorem `Equid.N.eval_nonneg`; any weighting with weights >= 0: `Equid.cost_nonneg`).
// What is proven: the formulas, over exact rational numbers, for every edge the loader accepts.
// What is not: f32 rounding, the correctness of the data, the `inputs` reader below, Dijkstra itself.
// See proof/README.md.
#![cfg_attr(rustfmt, rustfmt::skip)]
#![allow(unused_parens)]

use crate::features::{is_night, Mode, N_FEATURES};
use crate::graph::{Edge, Meta, Surface};

/// The readings of one edge, traversed in one direction at one time of day.
pub struct Inputs {
    pub len: f32, pub climb: f32, pub speed: f32, pub junction: f32,
    pub grade: f32, pub shade: f32, pub rough: f32, pub unlit: f32, pub flood: f32, pub green: f32, pub water: f32,
    pub near_bench: f32, pub near_toilets: f32, pub near_water: f32,
    pub busy: f32, pub lts: f32, pub crossings: f32, pub unsignalled: f32, pub kerb: f32, pub stops: f32,
    pub night: bool, pub steps: bool, pub covered: bool, pub no_sidewalk: bool, pub has_lts: bool, pub has_green_water: bool,
}

/// Hand-written reader (not proven; reads, defaults and lookup tables only).
pub fn inputs(edge: &Edge, forward: bool, mode: Mode, meta: &Meta, t_min: f32) -> Inputs {
    Inputs {
        len: edge.length_m,
        climb: if forward { edge.climb_m } else { edge.descent_m },
        speed: mode.speed_mps(),
        junction: edge.junction_crossings,
        grade: edge.max_grade_pct,
        shade: match &edge.shade {
            Some(slots) if !slots.is_empty() => {
                let i = (t_min.rem_euclid(1440.0) / meta.slot_min as f32) as usize % slots.len();
                slots[i]
            }
            _ if edge.covered => 1.0,
            _ => edge.tree.unwrap_or(0.0),
        },
        rough: match edge.surface {
            Some(Surface::Paved) => 0.0,
            Some(Surface::Compacted) => 0.33,
            Some(Surface::Unpaved) => 0.67,
            Some(Surface::Rough) => 1.0,
            None => 0.2,
        },
        unlit: match edge.lit {
            Some(true) => 0.0,
            Some(false) => 1.0,
            None => 0.5,
        },
        flood: edge.flood.unwrap_or(0.0),
        green: edge.green.unwrap_or(0.0),
        water: edge.water_view.unwrap_or(0.0),
        near_bench: edge.near_bench_m,
        near_toilets: edge.near_toilets_m,
        near_water: edge.near_water_m,
        busy: edge.busy as f32,
        lts: edge.lts.unwrap_or(0) as f32,
        crossings: edge.crossings as f32,
        unsignalled: edge.crossings_unsignalled as f32,
        kerb: edge.kerb_raised as f32,
        stops: edge.stops as f32,
        night: is_night(meta, t_min),
        steps: edge.steps,
        covered: edge.covered,
        no_sidewalk: edge.sidewalk == Some(false),
        has_lts: edge.lts.is_some(),
        has_green_water: edge.green.is_some() || edge.water_view.is_some(),
    }
}
"

def footer : String := "
/// Drop-in replacement for `features::edge_features`.
pub fn edge_features(edge: &Edge, forward: bool, mode: Mode, meta: &Meta, t_min: f32) -> [f32; N_FEATURES] {
    features_of(&inputs(edge, forward, mode, meta, t_min))
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::features::{self, FEATURES};
    use crate::graph::Graph;

    #[test]
    fn same_feature_order_as_the_engine() {
        let ids: Vec<&str> = FEATURES.iter().map(|f| f.id).collect();
        assert_eq!(ids, FEATURE_IDS);
    }

    /// Generated == hand-written, bit for bit, on every Princeton edge, both directions, both modes, day and night.
    #[test]
    fn generated_equals_hand_written_on_princeton() {
        let path = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/../data/princeton/graph.json\");
        let Ok(text) = std::fs::read_to_string(path) else {
            eprintln!(\"skipped: {path} not found\");
            return;
        };
        let mut g: Graph = serde_json::from_str(&text).unwrap();
        g.derive_junctions(); // as the loader does, so `junction` is exercised too
        let mut n = 0usize;
        for e in &g.edges {
            for forward in [true, false] {
                for mode in [Mode::Foot, Mode::Bike] {
                    for t in [0.0, 420.0, 600.0, 780.0, 960.0, 1000.0, 1200.0] {
                        let hand = features::edge_features_hand(e, forward, mode, &g.meta, t);
                        let gen = edge_features(e, forward, mode, &g.meta, t);
                        for k in 0..N_FEATURES {
                            let (a, b) = (hand[k], gen[k]);
                            assert_eq!(a.to_bits(), b.to_bits(), \"{} on edge {:?}: hand {a} vs generated {b}\", FEATURE_IDS[k], e.osm);
                            assert!(b >= 0.0, \"{} < 0\", FEATURE_IDS[k]);
                            n += 1;
                        }
                    }
                }
            }
        }
        assert!(n > 0);
    }
}
"

def render : String := Id.run do
  let ids := ", ".intercalate (features.map fun p => s!"\"{p.1}\"")
  let mut s := header
  s := s ++ s!"\n/// Feature ids in engine order (`features::FEATURES`).\npub const FEATURE_IDS: [&str; N_FEATURES] = [{ids}];\n"
  s := s ++ "\n/// The proven formulas, printed from Lean.\npub fn features_of(i: &Inputs) -> [f32; N_FEATURES] {\n    [\n"
  for (id, f) in features do
    s := s ++ s!"        // {id}\n        {f.rust},\n"
  s := s ++ "    ]\n}\n"
  s ++ footer

def main (args : List String) : IO Unit := do
  let out := args.headD "../engine/src/metrics_gen.rs"
  IO.FS.writeFile out render
  IO.println s!"wrote {out} ({features.length} features)"
